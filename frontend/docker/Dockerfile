FROM node:20 AS build

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

ARG VITE_GRAPHQL_URL=/graphql
ARG VITE_BASE_PATH=/
ARG VITE_YMAPS_API_KEY=7220b34d-c5b5-4211-8034-0063d1473c72
ENV VITE_GRAPHQL_URL=$VITE_GRAPHQL_URL
ENV VITE_BASE_PATH=$VITE_BASE_PATH
ENV VITE_YMAPS_API_KEY=$VITE_YMAPS_API_KEY

RUN npm run build

EXPOSE 4173
CMD ["npm", "run", "preview", "--", "--host", "0.0.0.0", "--port", "4173"]
